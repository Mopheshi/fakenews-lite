{
  "config": {
    "seed": 5,
    "use_pos_features": true,
    "strip_source_markers": false,
    "split": {
      "test_size": 0.2,
      "val_size_of_remainder": 0.125,
      "stratify": true
    },
    "tfidf": {
      "max_features": 10000,
      "ngram_range": [
        1,
        3
      ],
      "min_df": 2,
      "max_df": 0.9,
      "sublinear_tf": true,
      "svd_components": 300
    },
    "sequence": {
      "max_words": 50000,
      "max_len": 500,
      "embedding_dim": 100,
      "oov_token": "<OOV>"
    },
    "xgboost": {
      "max_depth": 7,
      "learning_rate": 0.1,
      "n_estimators": 200,
      "min_child_weight": 3,
      "gamma": 0.1,
      "subsample": 0.9,
      "colsample_bytree": 0.9,
      "objective": "binary:logistic",
      "eval_metric": "logloss",
      "n_jobs": -1
    },
    "text_cnn": {
      "filter_sizes": [
        3,
        4,
        5
      ],
      "num_filters": 128,
      "dense_units": 128,
      "dropout_rate": 0.5,
      "learning_rate": 0.001,
      "batch_size": 128,
      "epochs": 10,
      "early_stopping_patience": 3,
      "reduce_lr_patience": 2,
      "reduce_lr_factor": 0.5,
      "freeze_embeddings": true
    }
  },
  "blocklist_preset": "none",
  "vocab_size": 50000,
  "max_len": 500
}